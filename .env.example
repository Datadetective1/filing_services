# Copy to .env.local for LOCAL development and fill in. Never commit real values.
# .env.local is loaded by `next dev`, Playwright and every script, so it must only ever
# point at local or staging resources. Production credentials never go in .env.local.
#
# Secrets are per environment: never give Preview or Development a production secret.
# NEXT_PUBLIC_* values are public and inlined at build time: redeploy after changing one.
# Full Production / Preview / Development matrix: docs/OPERATIONS.md ("Production").
#
# Optional values must be left out entirely (or kept commented out), not blank: an empty
# value fails validation, and every payment and email path then errors. Lines below
# written as "# NAME=" are left out by default; uncomment one only to give it a real value
# (the comment above each says when it is required).

# --- Site and brand (public) ---
# Base URL for absolute links (auth emails, payment returns, canonical tags, sitemap).
# Production always uses https://www.getfilewell.com and ignores *.vercel.app or localhost here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand shown everywhere (default "Filewell").
NEXT_PUBLIC_BRAND_NAME=
# Public support address (default support@getfilewell.com). It must receive mail (MX) before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Legal name of the operating company. Blank = legal pages show a bracketed placeholder.
NEXT_PUBLIC_LEGAL_ENTITY=
# Postal address for legal notices and email footers. Blank = placeholder / omitted.
NEXT_PUBLIC_POSTAL_ADDRESS=
# Search indexing. Only "true" on the Production target, only with the owner's written
# approval. Previews and development are always noindex whatever this says.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase ---
# Local: `npx supabase status`. Staging project: iskphxoowsiuvvojswty. Production project
# (tnwpcprvetxtgyjuncrl) values are set on the Vercel Production target only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role). Server only.
SUPABASE_SECRET_KEY=
# Older names still accepted by the app, scripts and E2E when the names above are unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY (= publishable key), SUPABASE_SERVICE_ROLE_KEY (= secret key).
# Prefer the names above; never set both to different values.

# --- Security (secrets; different value per environment) ---
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs unsubscribe links and lookup cookies.
APP_SIGNING_SECRET=
# Salt for hashed IP addresses (rate limits, authorization records). 16+ characters.
# Optional locally (a development default is used); required with its own value on
# Preview and Production.
# IP_HASH_SALT=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders.
# 16+ characters. Required on Production; optional elsewhere.
# CRON_SECRET=

# --- Payments ---
# sandbox = built-in simulator (no money moves; refused on the production deployment).
# stripe = Stripe hosted Checkout (test keys only for a local Stripe test; Preview stays on
# the sandbox; production refuses test keys).
PAYMENTS_PROVIDER=sandbox
# Secret for the sandbox simulator's signed webhooks (local and staging only; not on
# Production). 16+ characters. Required while PAYMENTS_PROVIDER=sandbox.
# SANDBOX_WEBHOOK_SECRET=
# Live Stripe keys are refused unless this is exactly "true". Production only, owner approval.
PAYMENTS_LIVE_ENABLED=false
# Secrets. sk_test_ only for a local Stripe test (Preview stays on the sandbox), sk_live_ on
# Production only.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint registered for this environment's host.
STRIPE_WEBHOOK_SECRET=
# Emergency override that lets test payments run on the production deployment.
# NEVER set in production (or anywhere else).
# ALLOW_TEST_PAYMENTS_IN_PRODUCTION=
# Older name of the override above. This code no longer reads it, but deployments built
# before the launch sprint still honor it. NEVER set in production; remove it from Vercel
# if present.
# ALLOW_SANDBOX_IN_PRODUCTION=
# Lets the unit-test runner reach real Stripe instead of the sandbox. NEVER set; tests must
# stay on the sandbox.
# ALLOW_REAL_PAYMENTS_IN_TESTS=

# --- Email ---
# outbox = record emails in the database only (visible in /admin/notifications).
# resend = deliver through Resend. Resend delivers only on the production deployment
# (its default there); everywhere else the outbox is used even if a key is present.
EMAIL_PROVIDER=outbox
# Secret. Set on the Vercel Production target only; previews stay on the outbox.
RESEND_API_KEY=
# Sender on the verified domain (default "Filewell <filings@getfilewell.com>").
EMAIL_FROM=
# Reply-To (default NEXT_PUBLIC_SUPPORT_EMAIL). Must be a monitored mailbox.
EMAIL_REPLY_TO=
# Staging only: "true" lets EMAIL_PROVIDER=resend deliver outside production for a
# deliverability check. Never on Production (not needed) and never in .env.local.
# EMAIL_DELIVERY_OUTSIDE_PRODUCTION=

# --- Operator scripts and date QA ---
# Non-production only: pins the business clock to an ISO timestamp for date QA,
# e.g. 2026-10-01T09:00:00-04:00. Ignored on the production deployment.
# FILEWELL_CLOCK_OVERRIDE=
# Scripts only (seed, grant-staff, run-reminders): they refuse the production Supabase
# project unless this equals its ref (tnwpcprvetxtgyjuncrl). Pass it on the command line
# for a single run; never save it in a file.
# CONFIRM_PRODUCTION=

# --- Testing (Playwright; developer machine or CI only, never in Vercel) ---
# Playwright loads .env.local, then .env.e2e (if present) with override, so put
# E2E-only values in .env.e2e. E2E never uses the production Supabase project.
# Deployed app to test, e.g. a staging preview URL. Unset = `next start` on localhost:3000
# (run `npm run build` first). Against a production host only tests/e2e/public.spec.ts runs.
# E2E_BASE_URL=
# Temporary Vercel share link for a protected preview; visited once to capture the access cookie.
# E2E_SHARE_URL=
# Secret. Vercel "Protection Bypass for Automation" value, sent as a header to protected previews.
# VERCEL_AUTOMATION_BYPASS_SECRET=
