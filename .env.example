# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on the real production domain; previews are always noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Security ---
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SIGNING_SECRET=
IP_HASH_SALT=
CRON_SECRET=

# --- Payments ---
# sandbox = built-in simulator (no money moves). stripe = Stripe hosted Checkout.
PAYMENTS_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=
# Live keys are refused unless this is exactly "true". Leave false until launch approval.
PAYMENTS_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# outbox = record emails in the database only (visible in /admin/notifications).
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
